---
import CoupangBanner from '../components/CoupangBanner.astro';
import Layout from '../layouts/Layout.astro';import site from '../site.json';import guide from '../launch-content.json';import {getCollection} from 'astro:content';
const posts=(await getCollection('guides',({data})=>site.launchReady&&!data.draft&&data.reviewed&&data.language==='ko'&&data.sources.length>0));
---
<Layout><section class="hero"><div class="wrap"><p class="eyebrow">GuideHollow / {site.section}</p><h1>{site.hero}</h1><p class="lead">{site.description}</p><p>{guide.intro}</p><a class="button" href="#checks">상황별 점검 시작</a></div></section>
<CoupangBanner placement="home"/>
<section class="wrap section" id="checks"><h2>상황별 기본 점검</h2><p class="muted">증상이나 목적에 맞는 항목부터 살펴보세요.</p><div class="grid">{guide.checks.map((c,i)=><article class="card"><p class="eyebrow">점검 {String(i+1).padStart(2,'0')}</p><h3>{c.title}</h3><p>{c.when}</p><ol>{c.steps.map(x=><li>{x}</li>)}</ol><p class="tip">{c.tip}</p></article>)}</div></section><section class="wrap section"><div class="callout"><h2>먼저 알아둘 점</h2><p>이 사이트는 일반적인 확인 방법을 설명합니다. 제품 설명서·공식 기관 안내가 우선이며, 위험이 예상되면 사용을 중단하고 전문가에게 문의하세요.</p></div></section><section class="wrap section"><h2>자주 묻는 질문</h2>{guide.faq.map(q=><article><h3>{q.question}</h3><p>{q.answer}</p></article>)}</section><section class="wrap section"><h2>자세한 가이드</h2>{posts.length?<ul>{posts.map(p=><li><a href={'/guides/'+p.id+'/'}>{p.data.title}</a></li>)}</ul>:<p>상세 글은 검수 완료 후 이곳에 공개합니다.</p>}</section><section class="wrap section"><h2>공식 자료</h2><ul>{guide.references.map(r=><li><a href={r.url} rel="noopener noreferrer" target="_blank">{r.label}</a></li>)}</ul></section></Layout>