---
import CoupangBanner from '../components/CoupangBanner.astro';
import site from '../site.json';import '../styles/main.css';
const {coupangInPage=false,title=site.pageTitle,description=site.description,robots=site.launchReady?'index,follow':'noindex,follow'}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="naver-site-verification" content="f888ebd20c6e0b5ef2e7eb205c262e5385748721"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" href="/rss.xml" title="GuideHollow RSS"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:locale" content="ko_KR"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="GuideHollow"/></head><body style={'--accent:'+site.accent}><a class="skip" href="#main">본문으로 이동</a><header class="top"><div class="wrap bar"><a class="brand" href="/"><span class="mark">G</span>GuideHollow</a><nav aria-label="주요 메뉴"><a href="/">도구</a><a href="/guides/">가이드</a><a href="/about/">소개</a><a href="/editorial/">편집 원칙</a></nav></div></header><main id="main"><slot/></main>{!coupangInPage && <CoupangBanner placement="article"/>}<footer class="foot"><div class="wrap"><strong>GuideHollow</strong><p>{site.section} 작업을 돕는 한국어 도구</p><nav><a href="/privacy/">개인정보 안내</a><a href="/disclosure/">광고 안내</a><a href="/rss.xml">RSS</a></nav><small>© {new Date().getFullYear()} GuideHollow · 공식 제조사 또는 정부기관 사이트가 아닙니다.</small></div></footer></body></html>